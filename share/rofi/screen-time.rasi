configuration {
    font: "JetBrainsMono Nerd Font 12";
    show-icons: false;
    disable-history: true;
    hover-select: false;
    cycle: true;
    matching: "fuzzy";
}

* {
    background-color: #0d1117;
    text-color: #f0f6fc;
    border-color: #161b22;
    selected-normal-background: #161b22;
    selected-normal-foreground: #f0f6fc;
    normal-background: #0d1117;
    normal-foreground: #f0f6fc;
    foreground: #f0f6fc;
    background: #0d1117;
    spacing: 0;
    margin: 0;
    padding: 0;
}

window {
    width: 94%;
    height: 55%;
    location: center;
    anchor: center;
    border: 0;
    padding: 14px;
    background-color: #0d1117;
}

mainbox {
    background-color: #0d1117;
    children: [ listview ];
    spacing: 0;
}

inputbar {
    enabled: false;
}

listview {
    background-color: #0d1117;
    columns: 1;
    lines: 16;
    spacing: 0;
    scrollbar: false;
    cycle: true;
    dynamic: false;
}

element {
    padding: 2px 8px;
    background-color: #0d1117;
    text-color: #f0f6fc;
}

element selected {
    background-color: #161b22;
    text-color: #f0f6fc;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    font: "JetBrainsMono Nerd Font 12";
    vertical-align: 0.5;
}
